# Copy this file to `.env` and fill in the values before running locally.
# Never commit `.env` — it is listed in .gitignore.

# --- Server ---
# Default 3000. For this host's local stack use PORT=1029.
PORT=3000
NODE_ENV=development

# Session signing and profile encryption fallback (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated Master Account emails. These users get the admin role and
# can always sign in even when Allowed email domain is restricted.
ADMIN_EMAILS=minnyo.work@gmail.com

# Optional dedicated 32-byte base64 profile encryption key.
# If omitted, JWT_SECRET is used to derive the encryption key.
# PROFILE_ENCRYPTION_KEY=

# --- Supabase (required for sign-in, profile, and process history on Vercel) ---
# Local without Supabase: set VITE_USE_SUPABASE_AUTH=false and leave URL/keys empty
# (client also enables Supabase if both URL and publishable key are non-empty).
VITE_USE_SUPABASE_AUTH=true
VITE_SUPABASE_URL=https://lltzfiewqyhdbfvjqxon.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Processing API routing ---
# Keep false on Vercel so workbook uploads use same-origin /api/trpc.
VITE_USE_EXTERNAL_PROCESSING_API=false
# Local dev: point workbook routes at the local server (match PORT).
VITE_PROCESSING_API_URL=http://localhost:3000

# Allowed browser origins for API CORS (comma-separated)
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- reCAPTCHA (optional for local login; required for production) ---
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# RECAPTCHA_ALLOWED_HOSTNAMES=localhost

# --- Local Postgres (Drizzle / legacy metadata when Supabase is off) ---
# Example (Docker Postgres on host): postgres://postgres:postgres@localhost:5432/db_excel_data_analysis_tools
# DATABASE_URL=

# --- Local email-domain policy when Supabase is off ---
# Unset, empty, or * = accept any valid email for local SMTP OTP (default).
# Set a domain (e.g. punhlainghospitals.com) to restrict sign-in to that domain only.
ALLOWED_EMAIL_DOMAIN=*
# ALLOWED_EMAIL_DOMAIN=punhlainghospitals.com

# --- App-level SMTP (local / non-Supabase passwordless OTP) ---
# Office 365: smtp.office365.com:587 — mailbox must have Authenticated SMTP enabled.
# SMTP_USER and the address inside SMTP_FROM must be the SAME mailbox (e.g. ict@punhlainghospitals.com).
# Gmail may receive mail while @punhlainghospitals.com does not: check Exchange quarantine / junk / transport rules.
# If login fails with "basic authentication is disabled", enable SMTP AUTH for the mailbox (Exchange admin).
# When SMTP_* is incomplete, OTP codes are logged to the server console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Excel Master File <ict@punhlainghospitals.com>"

# --- Legacy Manus OAuth (not needed when using Supabase auth or local SMTP OTP) ---
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
