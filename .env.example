# Excel Data Analysis Tools — local development template
# Copy this file to .env. Never commit .env, .env.local, or any file containing real credentials.
# Values beginning with <...> are placeholders and must be replaced by the project owner.

NODE_ENV=development
PORT=3000

# Supabase browser configuration. These are publishable values, not service-role secrets.
VITE_USE_SUPABASE_AUTH=true
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>

# Supabase server-only configuration. Never prefix this variable with VITE_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key-from-secret-manager>

# Database compatibility path. Use only if the local server or legacy Drizzle path requires it.
DATABASE_URL=mysql://<username>:<password>@<host>:3306/<database>?sslaccept=strict

# Session and profile-encryption secrets. Generate unique local values; do not reuse production values.
JWT_SECRET=<random-local-session-secret-at-least-32-characters>
PROFILE_ENCRYPTION_KEY=<base64-encoded-32-byte-local-key>

# Application and legacy/auth compatibility settings.
VITE_APP_ID=<application-id-if-required>
OAUTH_SERVER_URL=<oauth-server-url-if-legacy-auth-is-required>
VITE_OAUTH_PORTAL_URL=<oauth-portal-url-if-legacy-auth-is-required>
OWNER_OPEN_ID=<local-owner-open-id-if-required>

# Optional Manus built-in services. Leave blank when not used locally.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Processing API routing. Keep external processing disabled for the normal local server.
VITE_USE_EXTERNAL_PROCESSING_API=false
VITE_PROCESSING_API_URL=

# CAPTCHA. Leave blank for local development unless localhost is registered with the provider.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# API origin and security configuration.
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# Informational only; SMTP credentials are not read from this project template.
SMTP_CONFIGURATION_NOTE=Use Supabase Auth SMTP configured by the project owner; do not place SMTP passwords in this repository.
